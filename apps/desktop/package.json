{
  "name": "@openagent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "../../dist/main/main.js",
  "scripts": {
    "dev": "vite --config ../../vite.config.ts --host 127.0.0.1",
    "dev:electron": "concurrently -k \"vite --config ../../vite.config.ts --host 127.0.0.1\" \"tsc -b ../../tsconfig.electron.json --force --watch --preserveWatchOutput\" \"wait-on tcp:5173 ../../dist/main/main.js && electron .\"",
    "build": "pnpm typecheck && vite --config ../../vite.config.ts build && pnpm build:main",
    "typecheck": "tsc -p ../../tsconfig.renderer.json --pretty false && tsc -p ../../tsconfig.electron.json --pretty false --noEmit",
    "preview": "vite --config ../../vite.config.ts preview --host 127.0.0.1",
    "build:main": "tsc -b ../../tsconfig.electron.json --force",
    "build:mac": "bash ../../scripts/build-macos.sh",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package-windows-installer.ps1",
    "build:win:bash": "bash ../../scripts/build-windows.sh",
    "build:all": "bash ../../scripts/build-all.sh",
    "package:macos:app": "bash ../../scripts/package-macos-app.sh",
    "package:macos:dmg": "bash ../../scripts/package-macos-dmg.sh",
    "package:windows:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package-windows-installer.ps1",
    "package:windows:installer:bash": "bash ../../scripts/package-windows-installer.sh"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.75.5",
    "@openagent/runtime": "workspace:*",
    "@openagent/pi-adapter": "workspace:*",
    "@openagent/skill-runtime": "workspace:*",
    "@openagent/knowledge": "workspace:*",
    "@openagent/plugin-runtime": "workspace:*",
    "@openagent/planning": "workspace:*",
    "@openagent/ui": "workspace:*",
    "@openagent/subagents": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "clsx": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "mermaid": "^11.15.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tailwind-merge": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
