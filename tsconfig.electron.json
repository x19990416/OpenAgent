{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist/main",
    "rootDir": "src/main",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/main"
  ]
}
