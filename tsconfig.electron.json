{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist/main",
    "rootDir": "apps/desktop/src/main",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@openagent/runtime": [
        "packages/runtime/dist/index.d.ts"
      ],
      "@openagent/planning": [
        "packages/planning/dist/index.d.ts"
      ],
      "@openagent/subagents": [
        "packages/subagents/dist/index.d.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "apps/desktop/src/main"
  ]
}
