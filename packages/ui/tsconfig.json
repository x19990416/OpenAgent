{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "react"
    ],
    "baseUrl": ".",
    "paths": {
      "@openagent/shared-types": [
        "../shared-types/dist/index.d.ts"
      ],
      "@openagent/shared-types/index": [
        "../shared-types/dist/index.d.ts"
      ],
      "@openagent/shared-types/events": [
        "../shared-types/dist/events.d.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
